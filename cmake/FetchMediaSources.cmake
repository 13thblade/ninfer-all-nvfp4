# cmake -DNINFER_MEDIA_SOURCES_DIR=<dir> -P cmake/FetchMediaSources.cmake
#
# Downloads the archives cmake/MediaSources.cmake pins into <dir> and checks their digests. An
# archive already there with the pinned digest is kept, so a second run downloads nothing.
cmake_minimum_required(VERSION 3.28)
include(${CMAKE_CURRENT_LIST_DIR}/MediaSources.cmake)
if(NOT NINFER_MEDIA_SOURCES_DIR)
  message(FATAL_ERROR "Pass -DNINFER_MEDIA_SOURCES_DIR=<directory>")
endif()
file(MAKE_DIRECTORY "${NINFER_MEDIA_SOURCES_DIR}")
foreach(source IN LISTS NINFER_MEDIA_SOURCES)
  set(archive "${NINFER_MEDIA_SOURCES_DIR}/${NINFER_${source}_ARCHIVE}")
  set(expected "${NINFER_${source}_SHA256}")
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" digest)
    if(digest STREQUAL expected)
      message(STATUS "Present: ${archive}")
      continue()
    endif()
    file(REMOVE "${archive}")
  endif()
  # The release servers reset connections now and then, which leaves a partial file.
  set(downloaded FALSE)
  foreach(attempt RANGE 1 4)
    file(DOWNLOAD "${NINFER_${source}_URL}" "${archive}.part" TLS_VERIFY ON STATUS status)
    list(GET status 0 code)
    if(code EQUAL 0)
      file(SHA256 "${archive}.part" digest)
      if(digest STREQUAL expected)
        set(downloaded TRUE)
        break()
      endif()
      set(status "SHA-256 ${digest}, expected ${expected}")
    endif()
    file(REMOVE "${archive}.part")
    message(STATUS "Attempt ${attempt} to download ${NINFER_${source}_URL} failed: ${status}")
  endforeach()
  if(NOT downloaded)
    message(FATAL_ERROR "Could not download ${NINFER_${source}_URL}")
  endif()
  file(RENAME "${archive}.part" "${archive}")
  message(STATUS "Downloaded: ${archive}")
endforeach()
